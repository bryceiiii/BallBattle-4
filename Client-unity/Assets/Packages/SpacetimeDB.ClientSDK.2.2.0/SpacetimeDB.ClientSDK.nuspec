<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SpacetimeDB.ClientSDK</id>
    <version>2.2.0</version>
    <title>SpacetimeDB SDK</title>
    <authors>jdetter</authors>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://spacetimedb.com/</projectUrl>
    <description>The SpacetimeDB SDK is a software development kit (SDK) designed to simplify the interaction with SpacetimeDB server modules.</description>
    <copyright>2024</copyright>
    <repository type="git" url="https://github.com/clockworklabs/com.clockworklabs.spacetimedbsdk" commit="eb11e2f5c41dce6979715ad407996270d61329f6" />
    <dependencies>
      <group targetFramework=".NETStandard2.1">
        <dependency id="SpacetimeDB.BSATN.Runtime" version="2.2.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>